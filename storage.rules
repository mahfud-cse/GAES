rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function active() {
      return request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function globalRole() {
      return profile().role in ['Super Admin','Admin','HO Admin','HO Ancillary Coordinator','HO Ancillary Verifier','Report Viewer'];
    }
    function visitorInScope(visitorId) {
      return firestore.exists(/databases/(default)/documents/visitors/$(visitorId))
        && (globalRole()
          || firestore.get(/databases/(default)/documents/visitors/$(visitorId)).data.airport == profile().station);
    }
    match /evidence/{visitorId}/{fileName} {
      allow read: if active() && visitorInScope(visitorId);
      allow write: if active() && visitorInScope(visitorId)
        && profile().role in ['Super Admin','Admin','BO Admin','Lounge Officer','Lounge Manager']
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/jpeg|image/png)');
    }
    match /display-content/{station}/{contentId}/{fileName} {
      allow read: if active();
      allow write: if active()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['Super Admin','Admin','HO Admin']
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('(image/jpeg|image/png|image/webp|video/mp4|video/webm)');
    }
    match /lounge-layouts/{station}/{layoutId}/{kind}/{fileName} {
      allow read: if true;
      allow write: if active()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['Super Admin','Admin','HO Admin','BO Admin','Lounge Manager']
        && (firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['Super Admin','Admin','HO Admin']
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.station == station)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('(image/jpeg|image/png|image/webp|image/svg\\+xml)');
    }
  }
}
